{
  "name": "@tsci/tscircuit.rp2350",
  "version": "0.0.1",
  "type": "module",
  "description": "RP2350 microcontroller module with USB-C programming, QSPI flash, and SWD test points, built with tscircuit",
  "main": "index.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics",
    "rp2350"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/bun": "^1.2.22",
    "@types/react": "^19.1.12",
    "tscircuit": "^0.0.2221",
    "typescript": "^5.9.2"
  }
}
